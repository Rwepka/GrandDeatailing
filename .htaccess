# Защитный .htaccess на случай, если корень сайта ошибочно укажут на этот каталог.
# Правильный корень сайта — каталог public/.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Закрываем служебные каталоги от прямого доступа из браузера.
    RewriteRule ^(src|config|views|database|storage)/ - [F,L]
</IfModule>
